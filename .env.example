# Port-Intelli Backend Environment Variables
# Copy this file to .env and fill in your keys.

# Google Gemini API Key (required for AI summaries)
GEMINI_API_KEY=

# Serper.dev API Key (required for stock news)
SERPER_API_KEY=

# Portfolio holdings as JSON (optional — falls back to sample data)
# PORTFOLIO_HOLDINGS_JSON=[{"symbol":"TATAMOTORS","quantity":50,"avg_price":620.0}]

# Comma-separated allowed CORS origins (optional — defaults to localhost dev origins)
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app,http://localhost:8080
